<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane styleClass="app-root" prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.hospital_manager.controllers.CadastroConsultaController">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <VBox styleClass="sidebar" BorderPane.alignment="CENTER">

            <VBox styleClass="sidebar-header">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="sidebar-logo-circle">
                        <Label text="⚕" styleClass="sidebar-logo-icon" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Clínica Dr. Luiz" styleClass="sidebar-brand" />
                        <Label text="Sistema de Gestão" styleClass="sidebar-brand-sub" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox styleClass="nav-list" VBox.vgrow="ALWAYS">
                <Button text="📊  Dashboard" styleClass="nav-item" onAction="#onDashboard" maxWidth="Infinity" />
                <Button text="👨‍⚕️  Médicos" styleClass="nav-item" onAction="#onMedicos" maxWidth="Infinity" />
                <Button text="👤  Pacientes" styleClass="nav-item" onAction="#onPacientes" maxWidth="Infinity" />
                <Button text="📅  Consultas" styleClass="nav-item-active" onAction="#onConsultas" maxWidth="Infinity" />
                <Button text="🔍  Busca" styleClass="nav-item" onAction="#onBusca" maxWidth="Infinity" />
                <Button text="📊  Relatórios" styleClass="nav-item" onAction="#onRelatorios" maxWidth="Infinity" />
            </VBox>

            <VBox styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👤" styleClass="stat-icon-glyph" />
                    <VBox spacing="2">
                        <Label text="Usuário" styleClass="sidebar-footer-label" />
                        <Label fx:id="lblUserName" text="Administrador" styleClass="sidebar-footer-name" />
                        <Label fx:id="lblUserRole" text="Gerente" styleClass="sidebar-footer-role" />
                    </VBox>
                </HBox>
                <Label fx:id="lblVisualizarPerfil" text="👤 Visualizar Perfil" 
                       styleClass="sidebar-profile-link" />
            </VBox>

            <VBox styleClass="medico-logout-box">
                <Button fx:id="btnSair" text="⏻  Sair" styleClass="medico-btn-logout" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </left>

    <!-- ===================== CONTENT ===================== -->
    <center>
        <HBox styleClass="content-area" spacing="18">

            <VBox spacing="22" HBox.hgrow="ALWAYS">

                <VBox spacing="4">
                    <Label text="Agendar Consulta" styleClass="page-title" />
                    <Label text="Preencha os dados para registrar uma nova consulta" styleClass="page-subtitle" />
                </VBox>

                <VBox styleClass="surface-card" maxWidth="780" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="28" right="28" bottom="28" left="28" />
                    </padding>

                    <!-- Paciente -->
                    <VBox spacing="6" style="-fx-padding: 0 0 16 0;">
                        <Label text="Paciente *" styleClass="form-label" />
                        <ComboBox fx:id="fldPaciente" promptText="Digite para buscar paciente..."
                                  styleClass="combo-input" maxWidth="Infinity" editable="true" />
                    </VBox>

                    <!-- Médico -->
                    <VBox spacing="6" style="-fx-padding: 0 0 16 0;">
                        <Label text="Médico *" styleClass="form-label" />
                        <ComboBox fx:id="fldMedico" promptText="Digite para buscar médico..."
                                  styleClass="combo-input" maxWidth="Infinity" editable="true" />
                    </VBox>

                    <!-- Data e Hora -->
                    <Label text="Data e hora" styleClass="panel-title" />
                    <Separator style="-fx-padding: 10 0 18 0;" />

                    <HBox spacing="16" style="-fx-padding: 0 0 16 0;">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Data *" styleClass="form-label" />
                            <DatePicker fx:id="fldData" promptText="dd/mm/aaaa"
                                        styleClass="date-input" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Hora *" styleClass="form-label" />
                            <ComboBox fx:id="fldHora" promptText="00:00"
                                      styleClass="combo-input" maxWidth="Infinity" />
                        </VBox>
                    </HBox>

                    <!-- Status -->
                    <Label text="Status" styleClass="panel-title" />
                    <Separator style="-fx-padding: 10 0 18 0;" />

                    <VBox spacing="6" style="-fx-padding: 0 0 24 0;">
                        <Label text="Status da consulta *" styleClass="form-label" />
                        <ComboBox fx:id="fldStatus" promptText="Selecione..."
                                  styleClass="combo-input" maxWidth="Infinity" />
                        <Label text="Novas consultas são criadas como SCHEDULED por padrão."
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;" />
                    </VBox>

                    <!-- Botões -->
                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="Cancelar" styleClass="btn-ghost" onAction="#onCancelar" />
                        <Button text="Agendar consulta" styleClass="btn-accent" onAction="#onSalvar" />
                    </HBox>

                    <!-- Label de erro -->
                    <Label fx:id="lblErro" text=""
                           style="-fx-text-fill: #dc2626; -fx-font-size: 13px;"
                           visible="false" managed="false" />
                </VBox>

            </VBox>

            <!-- Painel lateral de busca -->
            <VBox styleClass="surface-card" spacing="14" prefWidth="320" maxWidth="320">
                <padding>
                    <Insets top="18" right="16" bottom="18" left="16" />
                </padding>

                <VBox spacing="4">
                    <Label text="Buscar Médicos ou Pacientes" styleClass="panel-title" />
                    <Label text="Pesquise e veja os detalhes rapidamente" styleClass="empty-state-title" wrapText="true" />
                </VBox>

                <!-- Tipo de busca -->
                <VBox spacing="6">
                    <Label text="Buscar por" styleClass="form-label" />
                    <ComboBox fx:id="cmbTipoBusca" styleClass="combo-input" maxWidth="Infinity" />
                </VBox>

                <!-- Campo de busca -->
                <TextField fx:id="txtBusca" styleClass="text-input" 
                           promptText="Digite o termo de busca..." maxWidth="Infinity" />

                <!-- Botão buscar -->
                <Button fx:id="btnBuscar" text="🔍 Buscar" styleClass="btn-accent" maxWidth="Infinity" />

                <Separator style="-fx-padding: 8 0 8 0;" />

                <!-- Lista de resultados -->
                <Label text="Resultados" styleClass="form-label" />
                <ListView fx:id="lstResultados" styleClass="data-table" VBox.vgrow="ALWAYS" prefHeight="200" />

                <!-- Botões de ação -->
                <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="btnVerDetalhes" text="Ver Detalhes" styleClass="btn-accent" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnSelecionar" text="Selecionar" styleClass="btn-accent" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #059669;" />
                </HBox>
            </VBox>

        </HBox>
    </center>
</BorderPane>