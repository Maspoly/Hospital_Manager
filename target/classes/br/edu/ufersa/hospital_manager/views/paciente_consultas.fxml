<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="paciente-app-root" prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ufersa.hospital_manager.controllers.PacienteConsultasController">

    <!-- ===================== SIDEBAR ===================== -->
    <left>
        <VBox styleClass="paciente-sidebar" BorderPane.alignment="CENTER">

            <HBox styleClass="paciente-sidebar-header" spacing="9" alignment="CENTER_LEFT">
                <StackPane styleClass="paciente-sidebar-logo-badge">
                    <Label text="👤" styleClass="paciente-sidebar-logo-glyph" />
                </StackPane>
                <VBox spacing="1">
                    <Label text="Portal do Paciente" styleClass="paciente-sidebar-brand" />
                    <Label text="Clínica Dr. Luiz" styleClass="paciente-sidebar-brand-sub" />
                </VBox>
            </HBox>

            <HBox styleClass="paciente-profile-box" spacing="10" alignment="CENTER_LEFT">
                <StackPane>
                    <Circle radius="17" styleClass="paciente-avatar-circle" />
                    <Label fx:id="lblIniciais" text="M" styleClass="paciente-avatar-initial" />
                </StackPane>
                <VBox spacing="1">
                    <Label fx:id="lblNomePaciente" text="Maria Santos" styleClass="paciente-profile-name" />
                    <Label fx:id="lblCpfPaciente" text="CPF: 111.222.333-44" styleClass="paciente-profile-cpf" />
                    <!-- Link para visualizar perfil -->
                    <Label fx:id="lblVisualizarPerfil" text="👤 Visualizar Perfil" 
                           styleClass="sidebar-profile-link" onMouseClicked="#onVisualizarPerfil"/>
                </VBox>
            </HBox>

            <VBox styleClass="paciente-nav-list" VBox.vgrow="ALWAYS">
                <Button text="📊  Dashboard" styleClass="paciente-nav-item" onAction="#goDashboard" maxWidth="Infinity" />
                <Button text="📋  Meus Prontuários" styleClass="paciente-nav-item" onAction="#goProntuarios" maxWidth="Infinity" />
                <Button text="📅  Minhas Consultas" styleClass="paciente-nav-item-active" onAction="#goConsultas" maxWidth="Infinity" />
            </VBox>

            <VBox styleClass="paciente-logout-box">
                <Button text="⏻  Sair" styleClass="paciente-btn-logout" onAction="#onSair" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </left>

    <!-- ===================== CONTENT ===================== -->
    <center>
        <VBox styleClass="paciente-content-area" spacing="22">

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Minhas Consultas" styleClass="paciente-page-title" />
                    <Label text="Visualize e agende suas consultas" styleClass="paciente-page-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="+ Agendar Consulta" styleClass="paciente-btn-save" onAction="#onAgendarConsulta" />
            </HBox>

            <VBox styleClass="paciente-surface-card" VBox.vgrow="ALWAYS">
                <TableView fx:id="tableConsultas" styleClass="paciente-data-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <javafx.scene.control.TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colDataHora" text="DATA/HORA" prefWidth="150" />
                        <TableColumn fx:id="colMedico" text="MÉDICO" prefWidth="200" />
                        <TableColumn fx:id="colStatus" text="STATUS" prefWidth="130" />
                        <TableColumn fx:id="colAcoes" text="AÇÕES" prefWidth="120" />
                    </columns>
                    <placeholder>
                        <Label text="Nenhuma consulta agendada. Clique em &quot;Agendar Consulta&quot; para começar." />
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>