<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.hospital_manager.controllers.DashboardController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="230" styleClass="sidebar">

            <!-- Cabeçalho -->
            <VBox styleClass="sidebar-header">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="logo-icon" text="⚕" />
                    <VBox spacing="2">
                        <Label styleClass="sidebar-brand" text="Clínica Dr. Luiz" />
                        <Label styleClass="sidebar-brand-sub" text="Sistema de Gestão" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Navegação -->
            <VBox styleClass="nav-list" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#onDashboard" styleClass="nav-item-active" text="Dashboard" />
                <Button fx:id="btnMedicos" maxWidth="Infinity" onAction="#onMedicos" styleClass="nav-item" text="Médicos" />
                <Button fx:id="btnPacientes" maxWidth="Infinity" onAction="#onPacientes" styleClass="nav-item" text="Pacientes" />
                <Button fx:id="btnGerentes" maxWidth="Infinity" onAction="#onGerentes" styleClass="nav-item" text="Gerentes" />
                <Button fx:id="btnConsultas" maxWidth="Infinity" onAction="#onConsultas" styleClass="nav-item" text="Consultas" />
                <Button fx:id="btnBusca" maxWidth="Infinity" onAction="#onBusca" styleClass="nav-item" text="Busca" />
                <Button fx:id="btnRelatorios" maxWidth="Infinity" onAction="#onRelatorios" styleClass="nav-item" text="Relatórios" />
            </VBox>

            <!-- Rodapé com perfil -->
            <VBox styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="stat-icon-glyph" text="👤" />
                    <VBox spacing="2">
                        <Label styleClass="sidebar-footer-label" text="Usuário" />
                        <Label fx:id="lblUserName" styleClass="sidebar-footer-name" text="Administrador" />
                        <Label fx:id="lblUserRole" styleClass="sidebar-footer-role" text="Gerente" />
                    </VBox>
                </HBox>
                <!-- Link para visualizar perfil -->
                <Label fx:id="lblVisualizarPerfil" onMouseClicked="#onVisualizarPerfil" styleClass="sidebar-profile-link" text="👤 Visualizar Perfil" />
            </VBox>
            <VBox styleClass="medico-logout-box">
                <Button fx:id="btnSair" maxWidth="Infinity" onAction="#onSair" styleClass="medico-btn-logout" text="⏻  Sair" />
            </VBox>
        </VBox>
    </left>

    <!-- CONTEÚDO PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="24" styleClass="content-area">

                <!-- Boas-vindas -->
                <VBox spacing="4">
                    <Label fx:id="lblWelcome" styleClass="page-title" text="Bem-vindo, Administrador!" />
                    <Label styleClass="page-subtitle" text="Aqui está um resumo das atividades da clínica" />
                </VBox>

                <!-- Cards de métricas -->
                <GridPane hgap="18" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                    </columnConstraints>

                    <!-- Total de Médicos -->
                    <VBox spacing="8" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <StackPane maxHeight="46" maxWidth="46" minHeight="46" minWidth="46" styleClass="stat-icon-badge, stat-icon-blue">
                            <Label styleClass="stat-icon-glyph" text="👨‍⚕️" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Total de Médicos" />
                        <Label fx:id="lblTotalMedicos" styleClass="stat-value" text="0" />
                    </VBox>

                    <!-- Total de Pacientes -->
                    <VBox spacing="8" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <StackPane maxHeight="46" maxWidth="46" minHeight="46" minWidth="46" styleClass="stat-icon-badge, stat-icon-green">
                            <Label styleClass="stat-icon-glyph" text="👥" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Total de Pacientes" />
                        <Label fx:id="lblTotalPacientes" styleClass="stat-value" text="0" />
                    </VBox>

                    <!-- Total de Gerentes -->
                    <VBox spacing="8" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <StackPane maxHeight="46" maxWidth="46" minHeight="46" minWidth="46" styleClass="stat-icon-badge, stat-icon-purple">
                            <Label styleClass="stat-icon-glyph" text="👔" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Total de Gerentes" />
                        <Label fx:id="lblTotalGerentes" styleClass="stat-value" text="0" />
                    </VBox>

                    <!-- Consultas Pendentes -->
                    <VBox spacing="8" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <StackPane maxHeight="46" maxWidth="46" minHeight="46" minWidth="46" styleClass="stat-icon-badge, stat-icon-orange">
                            <Label styleClass="stat-icon-glyph" text="⚡" />
                        </StackPane>
                        <Label styleClass="stat-label" text="Consultas Pendentes" />
                        <Label fx:id="lblConsultasPendentes" styleClass="stat-value" text="0" />
                    </VBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
